<Window x:Class="EchoesOfAzeroth.ServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Loc[ServerManager]}"
        Width="1220" Height="820" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBackground}"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SidebarBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="34" Height="34"
                            Background="{StaticResource PrimarySoft}"
                            BorderBrush="{StaticResource PrimaryBorder}"
                            BorderThickness="1"
                            CornerRadius="9"
                            VerticalAlignment="Center">
                        <TextBlock Text="E" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource Primary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[AppName]}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Loc[ServerManager]}" FontSize="11"
                                   Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="13,7"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[ServerStatus]}" FontSize="10"
                                           Foreground="{StaticResource TextMuted}" />
                                <TextBlock Text="{Binding OverallStatusText}" FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WindowButton}" Content="—" FontSize="14"
                                Click="OnMinimizeClick" />
                        <Button Style="{StaticResource WindowButton}" Content="□" FontSize="13"
                                Click="OnMaximizeClick" />
                        <Button Style="{StaticResource CloseWindowButton}" Content="×" FontSize="18"
                                Click="OnCloseClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="26,20,26,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource WarningSoft}"
                        BorderBrush="{StaticResource WarningBorder}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="14,11"
                        Margin="0,0,0,14"
                        Visibility="{Binding HasValidationIssues, Converter={StaticResource BooleanVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="7"
                                Background="#3A2C18" Margin="0,0,11,0">
                            <TextBlock Text="!" Foreground="{StaticResource Warning}"
                                       FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Loc[ConfigurationWarning]}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Warning}" />
                            <TextBlock Text="{Binding ValidationSummary}" TextWrapping="Wrap"
                                       FontSize="11" Foreground="{StaticResource TextSecondary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,-12,14">
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" Background="{StaticResource PrimarySoft}"
                                        BorderBrush="{StaticResource PrimaryBorder}" BorderThickness="1" CornerRadius="8">
                                    <TextBlock Text="DB" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource Primary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Loc[Database]}"
                                           Style="{StaticResource SectionTitle}"
                                           Margin="11,0,0,0" VerticalAlignment="Center" />
                                <Ellipse Grid.Column="2" Width="9" Height="9"
                                         Fill="{Binding DatabaseStatus, Converter={StaticResource StatusBrush}}"
                                         VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding DatabaseStatusText}"
                                       Foreground="{Binding DatabaseStatus, Converter={StaticResource StatusBrush}}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,15,0,0" />
                            <TextBlock Grid.Row="2" Text="{Binding DatabasePortText}"
                                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0" />
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="{Binding Loc[Start]}" Command="{Binding StartDatabaseCommand}" />
                                <Button Content="{Binding Loc[Stop]}" Command="{Binding StopDatabaseCommand}" />
                                <Button Content="{Binding Loc[Restart]}" Command="{Binding RestartDatabaseCommand}" Margin="0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" Background="{StaticResource PrimarySoft}"
                                        BorderBrush="{StaticResource PrimaryBorder}" BorderThickness="1" CornerRadius="8">
                                    <TextBlock Text="AU" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource Primary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Loc[AuthServer]}"
                                           Style="{StaticResource SectionTitle}"
                                           Margin="11,0,0,0" VerticalAlignment="Center" />
                                <Ellipse Grid.Column="2" Width="9" Height="9"
                                         Fill="{Binding AuthStatus, Converter={StaticResource StatusBrush}}"
                                         VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding AuthStatusText}"
                                       Foreground="{Binding AuthStatus, Converter={StaticResource StatusBrush}}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,15,0,0" />
                            <TextBlock Grid.Row="2" Text="{Binding AuthPortText}"
                                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0" />
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="{Binding Loc[Start]}" Command="{Binding StartAuthCommand}" />
                                <Button Content="{Binding Loc[Stop]}" Command="{Binding StopAuthCommand}" />
                                <Button Content="{Binding Loc[Restart]}" Command="{Binding RestartAuthCommand}" Margin="0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" Background="{StaticResource PrimarySoft}"
                                        BorderBrush="{StaticResource PrimaryBorder}" BorderThickness="1" CornerRadius="8">
                                    <TextBlock Text="WR" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource Primary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Loc[WorldServer]}"
                                           Style="{StaticResource SectionTitle}"
                                           Margin="11,0,0,0" VerticalAlignment="Center" />
                                <Ellipse Grid.Column="2" Width="9" Height="9"
                                         Fill="{Binding WorldStatus, Converter={StaticResource StatusBrush}}"
                                         VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding WorldStatusText}"
                                       Foreground="{Binding WorldStatus, Converter={StaticResource StatusBrush}}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,15,0,0" />
                            <TextBlock Grid.Row="2" Text="{Binding WorldPortText}"
                                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0" />
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="{Binding Loc[Start]}" Command="{Binding StartWorldCommand}" />
                                <Button Content="{Binding Loc[Stop]}" Command="{Binding StopWorldCommand}" />
                                <Button Content="{Binding Loc[Restart]}" Command="{Binding RestartWorldCommand}" Margin="0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="2" Background="{StaticResource SidebarBackground}"
                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                        CornerRadius="11" Padding="11" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource PrimaryButton}"
                                Content="{Binding Loc[StartServer]}" Command="{Binding StartServerCommand}" />
                        <Button Grid.Column="1" Content="{Binding Loc[StopServer]}"
                                Command="{Binding StopServerCommand}" Padding="22,11" />
                        <Button Grid.Column="2" Style="{StaticResource QuietButton}"
                                Content="{Binding Loc[RestartServer]}" Command="{Binding RestartServerCommand}"
                                Padding="22,11" Margin="0" />
                        <ProgressBar Grid.Column="4" Width="110" Height="4"
                                     Foreground="{StaticResource Primary}"
                                     Background="{StaticResource PanelRaised}"
                                     BorderThickness="0"
                                     IsIndeterminate="True"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}" />
                    </Grid>
                </Border>

                <TabControl Grid.Row="3">
                    <TabItem Header="{Binding Loc[Logs]}">
                        <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                            <TabItem Header="{Binding Loc[World]}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="{StaticResource ConsoleBackground}"
                                            BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                                            CornerRadius="8" Padding="5">
                                        <ListBox x:Name="WorldLogList" ItemsSource="{Binding WorldLogs}"
                                                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayText}" TextWrapping="NoWrap" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding WorldCommandText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding CanSendWorldCommand}"
                                                 Margin="0,0,10,0">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding SendWorldCommandCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Button Grid.Column="1" Content="{Binding Loc[Send]}"
                                                Command="{Binding SendWorldCommandCommand}" Margin="0" />
                                    </Grid>
                                </Grid>
                            </TabItem>
                            <TabItem Header="{Binding Loc[Auth]}">
                                <Border Background="{StaticResource ConsoleBackground}"
                                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                                        CornerRadius="8" Padding="5">
                                    <ListBox x:Name="AuthLogList" ItemsSource="{Binding AuthLogs}"
                                             FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding DisplayText}" /></DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </TabItem>
                            <TabItem Header="{Binding Loc[Manager]}">
                                <Border Background="{StaticResource ConsoleBackground}"
                                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                                        CornerRadius="8" Padding="5">
                                    <ListBox x:Name="ManagerLogList" ItemsSource="{Binding ManagerLogs}"
                                             FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </TabItem>

                    <TabItem Header="{Binding Loc[Settings]}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <UniformGrid Columns="3" Margin="0,0,-12,0">
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Loc[Database]}"
                                                       Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />
                                            <TextBlock Text="{Binding Loc[ServerRootPath]}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Settings.ServerRootPath}" />
                                            <TextBlock Text="{Binding Loc[MySqlServiceName]}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Settings.MySqlServiceName}" />
                                            <TextBlock Text="{Binding Loc[MySqlPort]}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Settings.MySqlPort}" />
                                            <TextBlock Text="{Binding Loc[Language]}" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding Languages}"
                                                      SelectedItem="{Binding SelectedLanguage}"
                                                      DisplayMemberPath="DisplayName" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Loc[AuthServer]}"
                                                       Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />
                                            <TextBlock Text="{Binding Loc[AuthServerExecutable]}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Settings.AuthServerExecutable}" />
                                            <TextBlock Text="{Binding Loc[AuthServerArguments]}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Settings.AuthServerArguments}" />
                                            <TextBlock Text="{Binding Loc[AuthServerPort]}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Settings.AuthServerPort}" />
                                            <TextBlock Text="{Binding Loc[StartupTimeout]}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Settings.StartupTimeoutSeconds}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Loc[WorldServer]}"
                                                       Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />
                                            <TextBlock Text="{Binding Loc[WorldServerExecutable]}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Settings.WorldServerExecutable}" />
                                            <TextBlock Text="{Binding Loc[WorldServerArguments]}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Settings.WorldServerArguments}" />
                                            <TextBlock Text="{Binding Loc[WorldServerPort]}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Settings.WorldServerPort}" />
                                            <TextBlock Text="{Binding Loc[GracefulShutdownTimeout]}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Settings.GracefulShutdownTimeoutSeconds}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Background="{StaticResource PanelBackground}"
                                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                                        CornerRadius="10" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Loc[LogsDirectory]}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Settings.LogsDirectory}" />
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Content="{Binding Loc[SaveSettings]}"
                                                Command="{Binding SaveSettingsCommand}"
                                                HorizontalAlignment="Left" Margin="0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</Window>
